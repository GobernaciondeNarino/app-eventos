# Configuración con credenciales y la llave de cifrado: la escribe el
# instalador y nunca debe llegar al repositorio. Perderla vuelve ilegibles
# los documentos guardados.
/config/config.php
/config/instalacion.php
/config/permitir-reinstalar
/config/*.local.php
/config/.conexion-*.tmp
/config/.config-*.tmp
/config/.llave-asistente

# Subidas y datos de cada instalación
/almacen/logos/*
/almacen/fotos/*
/almacen/documentos/*
/almacen/respaldos/*
/almacen/registro/*
!/almacen/*/.gitignore

# Salidas de las pruebas
/pruebas/capturas/

# Volcados y respaldos de base de datos
*.sql.gz
*.dump

# Sistema y editores
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Node y Python: solo para herramientas y pruebas, nunca en producción
node_modules/
npm-debug.log*
__pycache__/
*.pyc
.venv/
